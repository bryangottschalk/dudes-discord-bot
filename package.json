  "description": "Discord announcer bot that plays user-specific audio clips when members join/leave the designated channel, announcing their presence.",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --watch src -e ts --exec ts-node -r dotenv/config src/index.ts",
    "build": "rm -rf dist && tsc"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "axios": "^1.14.0",
    "discord-tts": "^1.2.2",
    "discord.js": "^14.26.0",
    "express": "^5.2.1",
    "ffmpeg": "^0.0.4",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "dotenv": "^17.4.0",
    "eslint": "^10.1.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
