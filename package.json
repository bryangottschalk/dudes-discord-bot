{
  "name": "dudes-discord-bot",
  "version": "1.0.0",
  "description": "Discord announcer bot that plays user-specific audio clips when members join/leave the designated channel, announcing their presence.",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --watch src -e ts --exec ts-node -r dotenv/config src/index.ts",
    "build": "rm -rf dist && tsc"
  },
  "engines": {
    "node": "20.x || 22.x"
  },
  "overrides": {
    "body-parser": "1.20.4",
    "path-to-regexp": "0.1.13",
    "qs": "6.15.0"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "axios": "^1.14.0",
    "discord.js": "^14.26.0",
    "express": "^4.22.1",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.7.16",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
